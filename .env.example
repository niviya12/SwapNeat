# GEMINI_API_KEY: Optional for Gemini features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database URI (Optional - If not specified, SwapNeat operates with persistent high-performance JSON data store)
MONGODB_URI="mongodb://localhost:27017/swapneat"

# JWT Secret for user session tokens
JWT_SECRET="swapneat_tamilnadu_super_secret_jwt_key_2026"

# Server Port
PORT=3000
